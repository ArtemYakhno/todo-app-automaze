generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  todo
  in_progress
  done
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  priority    Int
  tags        String[]   @default([])
  dueDate     DateTime?
  status      TaskStatus @default(todo)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

# Backend
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Docker Compose) — isolated container, separate port from todo-app-viyar
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_password
POSTGRES_DB=todo_app
POSTGRES_PORT=5433

# Prisma — assembled from POSTGRES_* above (host localhost, since the backend runs on the host)
DATABASE_URL="postgresql://todo_user:todo_password@localhost:5433/todo_app"

# Frontend (Next.js) — the root .env is loaded via next.config.ts (dotenv)
NEXT_PUBLIC_API_URL=http://localhost:3001
